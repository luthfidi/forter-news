# =================================================
# === Forter Smart Contracts Environment        ===
# =================================================
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to your repository.

# --- Wallet ---
# Your wallet private key. MUST be kept secret.
# Example: 0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
PRIVATE_KEY=0x3c1ca6aa18fe806abe3a753bdd9f34d29b2e2af725b324edb183d86a47e68791

# --- RPC Endpoints ---
# RPC URL for Base Sepolia testnet.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
MANTLE_SEPOLIA_RPC_URL=https://rpc.sepolia.mantle.xyz

# --- Etherscan/Basescan API ---
# API key for contract verification on Basescan.
# Get it at: https://basescan.org/myapikey
BASESCAN_API_KEY=